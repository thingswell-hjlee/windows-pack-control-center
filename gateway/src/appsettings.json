{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=controlcenter.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Mqtt": {
    "DefaultPort": 1883,
    "ReconnectDelaySeconds": 5,
    "HeartbeatTimeoutSeconds": 60
  },
  "AllowedHosts": "*"
}
